# EcoRoute AI - Environment Variables Template
# Copy this to .env for local development

# 1. Frontend API URL (Used on Vercel to point to your Render backend)
# Example: VITE_API_URL=https://ecoroute-ai-backend.onrender.com/api
VITE_API_URL=

# 2. Firebase Configuration (Optional cloud Firestore sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 3. Backend Port (Render sets this automatically)
PORT=5000

# 4. SMS Cellular Gateways (Optional for physical SMS dispatch)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
