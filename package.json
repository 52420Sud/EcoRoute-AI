{
  "name": "ecoroute-ai",
  "private": true,
  "version": "1.0.0",
  "description": "EcoRoute AI - Smart Waste Management System Using IoT & AI",
  "author": "52420Sud",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:all": "node scripts/start-all.js",
    "dev:all": "node scripts/start-all.js",
    "dev": "vite",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "electron:dev": "electron .",
    "electron:build": "tsc -b && vite build && electron-builder --win",
    "electron:portable": "tsc -b && vite build && electron-builder --win portable",
    "electron:dir": "tsc -b && vite build && electron-builder --win --dir",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.ecoroute.smartwaste",
    "productName": "EcoRoute AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/icons/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EcoRoute AI"
    }
  }
}
